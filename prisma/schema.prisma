// StatsPilot — analytics data model
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  passwordHash String?  // null for OAuth-only accounts (e.g. Google)
  createdAt    DateTime @default(now())

  projects Project[]
}

model Project {
  id        String   @id @default(cuid())
  name      String
  domain    String
  trackingId String  @unique @default(cuid())
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  sessions  Session[]
  pageViews PageView[]
  events    Event[]

  @@index([trackingId])
  @@index([ownerId])
}

enum ProjectStatus {
  ACTIVE
  PAUSED
}

model Session {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitorId   String
  referrer    String?
  device      String?
  browser     String?
  country     String?
  startedAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  pageViews   PageView[]

  @@index([projectId, startedAt])
  @@index([projectId, visitorId])
}

model PageView {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  path      String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, path])
}

model Event {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitorId String
  name      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([projectId, name, createdAt])
}
