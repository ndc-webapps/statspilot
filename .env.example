# Neon / Supabase / any Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Auth.js secret — generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-long-random-string"

# Canonical app URL. Keep this exact host in Google OAuth redirect settings.
AUTH_URL="http://localhost:3000"

# Google OAuth (optional). If unset, the "Continue with Google" button is hidden.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:  https://YOUR_DOMAIN/api/auth/callback/google
#                  (local)  http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Set to "true" to seed/display demo data when a new account has no projects yet
NEXT_PUBLIC_DEMO_MODE="true"
